# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε τις τιμές.
# Το .env ΔΕΝ ανεβαίνει στο GitHub (είναι στο .gitignore).

# --- MySQL / MariaDB (π.χ. XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartbeach

# --- JWT: βάλε ένα μεγάλο τυχαίο κείμενο ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Κανόνες κρατήσεων ---
SEASON_START_MONTH=5
SEASON_END_MONTH=10
# Ωράριο που παίρνει ένα ΝΕΟ κατάστημα (το κάθε κατάστημα το αλλάζει μετά από την εφαρμογή)
DEFAULT_OPEN_TIME=08:00
DEFAULT_CLOSE_TIME=20:00
MIN_BOOKING_MINUTES=60
HALF_DAY_MAX_HOURS=6
HALF_DAY_FACTOR=0.6
# false = το προσωπικό μπορεί να κάνει check-in και σε κράτηση άλλης ημέρας (χρήσιμο σε παρουσίαση εκτός σεζόν)
CHECKIN_REQUIRE_TODAY=true

# --- Email κρατήσεων ---
# Αν το SMTP_HOST μείνει κενό, τα email ΔΕΝ στέλνονται: αποθηκεύονται ως αρχεία .eml
# στον φάκελο backend/outbox/ (άνοιξέ τα με διπλό κλικ για να δεις πώς φαίνονται).
# Με Gmail: ενεργοποίησε "Επαλήθευση σε 2 βήματα" και φτιάξε "Κωδικό εφαρμογής"
# στο https://myaccount.google.com/apppasswords - αυτόν βάζεις στο SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=to-email-sou@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop   (ο κωδικός εφαρμογής, 16 γράμματα χωρίς κενά)
# MAIL_FROM=SmartBeach <to-email-sou@gmail.com>

# --- AI Βοηθός (Claude API) - κλειδί από https://platform.claude.com ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low

# --- CORS (για Expo web). * = όλα ---
CORS_ORIGINS=*
